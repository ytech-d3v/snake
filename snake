<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Snake</title>
  <style>
    body {
      margin: 0;
      background: #111;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      font-family: system-ui, sans-serif;
      color: #eee;
    }
    canvas {
      background: #1a1a1a;
      border: 3px solid #333;
      border-radius: 8px;
      box-shadow: 0 0 30px rgba(0,0,0,0.5);
    }
    #score {
      font-size: 24px;
      margin: 15px 0;
      font-weight: bold;
    }
    #message {
      font-size: 18px;
      height: 30px;
      color: #4ade80;
    }
  </style>
</head>
<body>
  <div id="score">Score : 0</div>
  <canvas id="game" width="400" height="400"></canvas>
  <div id="message">Appuie sur une flèche pour commencer</div>

  <script>
    const canvas = document.getElementById('game');
    const ctx = canvas.getContext('2d');
    const scoreEl = document.getElementById('score');
    const messageEl = document.getElementById('message');

    const grid = 20;
    const tileCount = canvas.width / grid;

    let snake = [{x: 10, y: 10}];
    let food = {x: 15, y: 15};
    let dx = 0;
    let dy = 0;
    let score = 0;
    let gameRunning = false;
    let gameOver = false;

    function draw() {
      // Fond
      ctx.fillStyle = '#1a1a1a';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Serpent
      snake.forEach((segment, i) => {
        ctx.fillStyle = i === 0 ? '#4ade80' : '#22c55e';
        ctx.fillRect(segment.x * grid, segment.y * grid, grid - 2, grid - 2);
      });

      // Nourriture
      ctx.fillStyle = '#ef4444';
      ctx.beginPath();
      ctx.arc(food.x * grid + grid/2, food.y * grid + grid/2, grid/2 - 2, 0, Math.PI * 2);
      ctx.fill();
    }

    function move() {
      if (!gameRunning || gameOver) return;

      const head = {x: snake[0].x + dx, y: snake[0].y + dy};

      // Collision avec les murs
      if (head.x < 0 || head.x >= tileCount || head.y < 0 || head.y >= tileCount) {
        endGame();
        return;
      }

      // Collision avec soi-même
      if (snake.some(seg => seg.x === head.x && seg.y === head.y)) {
        endGame();
        return;
      }

      snake.unshift(head);

      // Manger
      if (head.x === food.x && head.y === food.y) {
        score += 10;
        scoreEl.textContent = `Score : ${score}`;
        placeFood();
      } else {
        snake.pop();
      }
    }

    function placeFood() {
      do {
        food = {
          x: Math.floor(Math.random() * tileCount),
          y: Math.floor(Math.random() * tileCount)
        };
      } while (snake.some(seg => seg.x === food.x && seg.y === food.y));
    }

    function endGame() {
      gameOver = true;
      gameRunning = false;
      messageEl.textContent = `Game Over ! Score final : ${score} — Appuie sur Espace pour rejouer`;
      messageEl.style.color = '#ef4444';
    }

    function reset() {
      snake = [{x: 10, y: 10}];
      dx = 0;
      dy = 0;
      score = 0;
      scoreEl.textContent = 'Score : 0';
      gameOver = false;
      gameRunning = false;
      placeFood();
      messageEl.textContent = 'Appuie sur une flèche pour commencer';
      messageEl.style.color = '#4ade80';
      draw();
    }

    document.addEventListener('keydown', e => {
      if (gameOver && e.code === 'Space') {
        reset();
        return;
      }

      if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.code)) {
        e.preventDefault();
        if (!gameRunning && !gameOver) {
          gameRunning = true;
          messageEl.textContent = '';
        }
      }

      // Empêcher de revenir sur soi-même
      if (e.code === 'ArrowUp' && dy !== 1) { dx = 0; dy = -1; }
      if (e.code === 'ArrowDown' && dy !== -1) { dx = 0; dy = 1; }
      if (e.code === 'ArrowLeft' && dx !== 1) { dx = -1; dy = 0; }
      if (e.code === 'ArrowRight' && dx !== -1) { dx = 1; dy = 0; }
    });

    // Boucle de jeu
    setInterval(() => {
      move();
      draw();
    }, 100);

    // Dessin initial
    draw();
  </script>
</body>
</html>